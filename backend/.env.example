APP_PORT=5000

# URL pública do backend. Usada para montar o notification_url enviado ao
# MercadoPago: <APP_PUBLIC_URL>/publica/webhooks/mercadopago
# Sem ela o PIX é criado do mesmo jeito, mas a confirmação passa a depender
# apenas do polling de /publica/payment/status/:paymentId
APP_PUBLIC_URL=https://hassisconecta.com.br

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_BASE_URL_API=https://api.mercadopago.com
# Chave secreta do webhook (painel do MercadoPago > Suas integrações >
# Webhooks). Se ficar vazia, a assinatura x-signature não é validada.
MERCADOPAGO_WEBHOOK_SECRET=

# Credenciais do Firebase usadas para as notificações push
FIREBASE_CREDENTIALS_PATH=

# SERVIDOR DB LOCAL
DB_USERNAME=admin
DB_PASSWORD=local
DB_HOST=localhost
DB_PORT=3306
DB_NAME=construirbarato

# LocalhHost
DIR_UPLOAD=../files/images/upload
